[Unit]
Description=产业链跟踪系统
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/invest-system
EnvironmentFile=-/home/ubuntu/invest-system/.env
Environment=CHAIN_YAML=/home/ubuntu/invest-system/config/chains/baijiu.yaml
Environment=SYMBOL=600519
ExecStart=/home/ubuntu/invest-system/.venv/bin/python main.py
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
