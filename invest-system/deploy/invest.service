[Unit]
Description=产业链跟踪系统
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/invest-system
EnvironmentFile=-/root/invest-system/.env
Environment=CHAIN_YAML=/root/invest-system/config/chains/baijiu.yaml
Environment=SYMBOL=600519
ExecStart=/root/invest-system/.venv/bin/python main.py
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
