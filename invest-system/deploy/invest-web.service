[Unit]
Description=产业链跟踪 Web 展示
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/invest-system
EnvironmentFile=-/home/ubuntu/invest-system/.env
Environment=SYMBOL=600519
ExecStart=/home/ubuntu/invest-system/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
